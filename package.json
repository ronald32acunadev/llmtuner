{
  "name": "llm-tuner",
  "version": "0.1.0",
  "description": "Detects your hardware and finds the fastest configuration to run local LLMs with LM Studio or Ollama.",
  "type": "module",
  "main": "src/core/index.js",
  "bin": {
    "llm-tuner": "src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js",
    "web": "node src/web/server.js",
    "desktop": "node electron/launch.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.llm-tuner.app",
    "productName": "LLM Tuner",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "src/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "license": "MIT",
  "allowScripts": {
    "electron@38.8.6": true
  }
}
